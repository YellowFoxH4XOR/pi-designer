  "narrative": {
    "northStar": "A place for ideas to take shape",
    "overview": "A light, operational Mac workspace with its own designer-tool identity: a pen nib shapes a Bézier curve on an ivory artboard, set against vermilion. The workspace shell keeps its existing lavender-gray tonal separation; the artifact sits on a clean canvas. The app mark deliberately departs from πDesk rather than repeating its π tile. The reference informs familiar workspace hierarchy and density, not cloud accounts, invented sharing features, or another product’s identity.\n\nKey characteristics: persistent navigation, a prompt-first starting point, restrained typography, and an artifact-led studio. The interface is desktop-only. Device frames describe generated prototypes, not app clients.",
    "keyCharacteristics": [
      "persistent navigation",
      "a prompt-first starting point",
      "restrained typography",
      "an artifact-led studio"
    ],
    "rules": [
      {
        "name": "The Artifact Boundary Rule",
        "body": "Workspace colors stop at the prototype iframe. A selected design system controls the artifact’s colors; it never recolors the app shell.",
        "section": "colors"
      }
    ],
    "dos": [
      "Do preserve the separation between the workspace and the generated artifact.",
      "Do use the real catalog and local run state, including empty and failure cases.",
      "Do keep omp-only execution and local storage explicit without making it the visual focus.",
      "Do keep native keyboard conventions and visible focus."
    ],
    "donts": [
      "Don’t add account, billing, publishing, or collaboration controls without working capabilities.",
      "Don’t describe prototype frames as separate native app generators or πDesigner clients.",
      "Don’t imply the light theme has a complete dark-mode counterpart."
    ]
  }
}

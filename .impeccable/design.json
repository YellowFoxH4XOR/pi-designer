  "narrative": {
    "northStar": "The light creative studio",
    "overview": "A focused Mac workspace with cool gray navigation, an off-white canvas, white working surfaces, and restrained warm coral actions. The user's latest correction establishes a light theme while preserving the redesigned layout and behavior. Fine borders and tonal layers separate the brief, conversation, and artifact without glows or decorative motion.\n\nThe retained vermilion, ivory, and ink pen-nib mark gives the product its designer-tool identity. Its editable Bézier curve appears as a small authored illustration on Home. Prototype specimens may show other palettes inside their own bounds; the workspace remains consistent around them. The native window uses aqua with the shell background, so web content and AppKit form one light workspace.",
    "keyCharacteristics": [
      "Cool neutral layers and fine rules.",
      "Restrained warm coral actions and visible focus.",
      "Persistent navigation and a brief-first creation surface.",
      "An artifact-led Studio with faithful execution states."
    ],
    "rules": [
      {
        "name": "The Artifact Boundary Rule",
        "body": "Workspace colors stop at the prototype iframe. A selected design system controls the artifact’s colors; it never recolors the app shell.",
        "section": "colors"
      },
      {
        "name": "The Labeled State Rule",
        "body": "Color and working dots reinforce execution labels; they never replace the reported state or transport health.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve the separation between the workspace and the generated artifact.",
      "Do use the real catalog and local run state, including empty and failure cases.",
      "Do keep omp-only execution and local storage explicit without making it the visual focus.",
      "Do keep native keyboard conventions and visible focus.",
      "Do use light neutral layers and warm coral actions consistently across shell, library, Studio, and dialogs."
    ],
    "donts": [
      "Don't add account, billing, publishing, or collaboration controls without working capabilities.",
      "Don't describe prototype frames as separate native app generators or πDesigner clients.",
      "Don't recolor prototype content to match the light workspace.",
      "Don't imply the light workspace has a complete alternate dark theme or theme-switching control."
    ]
  }
}
